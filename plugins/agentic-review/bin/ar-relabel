#!/usr/bin/env python3
"""Rewrite the citation labels in 5-final/review.md from 5-final/citation_map.tsv, matching each [label](url) link
by its URL. Run it after `ar-citemap` changed labels, so that `ar-check-review` passes again.

The previous file is kept as 5-final/review.before_relabel.md. Links whose URL is not in the map are left as they
are and listed. Exit 1 when such links remain, 0 otherwise.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import argparse
import re

import arlib

REVIEW = "5-final/review.md"
LINK = re.compile(r"\[([^\]\n]+)\]\((https?://[^)\s]+)\)")


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="ar-relabel", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("dir", help="review folder")
    ap.add_argument("--dry-run", action="store_true", help="report what would change, write nothing")
    args = ap.parse_args(argv)
    rdir = arlib.review_dir(args.dir)
    path = rdir / REVIEW
    cmap = arlib.load_citemap(rdir)
    if not path.exists() or not cmap:
        print(f"missing {REVIEW} or {arlib.CITEMAP}")
        return 1
    by_url = {}
    for row in cmap.values():
        url = (row.get("url") or "").strip()
        if url:
            by_url.setdefault(url, row.get("label"))
    text = path.read_text(encoding="utf-8")
    changed, unknown = [], []

    def swap(m):
        label, url = m.group(1), m.group(2)
        new = by_url.get(url)
        if new is None:
            unknown.append(f"{label} -> {url}")
            return m.group(0)
        if new != label:
            changed.append((label, new))
        return f"[{new}]({url})"

    out = LINK.sub(swap, text)
    print(f"links relabelled: {len(changed)} ({len(set(changed))} distinct) | links not in the map: {len(unknown)}")
    for old, new in sorted(set(changed))[:40]:
        print(f"  {old} -> {new}")
    for u in unknown[:20]:
        print(f"  not in map: {u}")
    if changed and not args.dry_run:
        backup = rdir / "5-final" / "review.before_relabel.md"
        arlib.atomic_write_text(backup, text)
        arlib.atomic_write_text(path, out)
        print(f"wrote {REVIEW} (previous version: {arlib.rel(rdir, backup)})")
    return 1 if unknown else 0


if __name__ == "__main__":
    sys.exit(main())
